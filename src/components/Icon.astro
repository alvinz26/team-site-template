---
// Simple line icons drawn inline (SPEC constraint 5: no icon fonts or CDNs).
// Decorative: always aria-hidden; the surrounding link carries the accessible name.
interface Props {
  name: 'instagram' | 'facebook' | 'x' | 'tiktok' | 'youtube' | 'whatsapp' | 'website' | 'mail' | 'photo' | 'menu';
}
const { name } = Astro.props;
---
<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'instagram' && (<><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" /></>)}
  {name === 'facebook' && <path d="M15 3h-2.5A3.5 3.5 0 0 0 9 6.5V10H6.5v3.5H9V21h3.5v-7.5H15l.5-3.5h-3V7a1 1 0 0 1 1-1H15z" />}
  {name === 'x' && <path d="M4 4l16 16M20 4L4 20" />}
  {name === 'tiktok' && <path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.6 2.6 2.4 4.2 5 4.5" />}
  {name === 'youtube' && (<><rect x="2.5" y="5.5" width="19" height="13" rx="4" /><path d="M10 9.5v5l4.5-2.5z" fill="currentColor" /></>)}
  {name === 'whatsapp' && (<><path d="M4 20l1.3-3.9A8 8 0 1 1 8.2 19z" /><path d="M9 9.5c.3 2.2 2.3 4.4 4.8 5l1.2-1.3-1.8-1-.9.8a4 4 0 0 1-2-2l.8-.9-1-1.8z" /></>)}
  {name === 'website' && (<><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></>)}
  {name === 'mail' && (<><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></>)}
  {name === 'photo' && (<><rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="9" cy="10" r="2" /><path d="M21 16l-5-5-9 9" /></>)}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
</svg>
