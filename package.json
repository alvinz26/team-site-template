{
  "name": "team-site-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A static, zero-backend website template for sports teams and student clubs.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "pretest": "node -e \"require('node:fs').rmSync('.test-work',{recursive:true,force:true})\"",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "astro": "7.3.8",
    "sharp": "0.35.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.19.2",
    "node-html-parser": "9.0.4",
    "typescript": "6.0.3"
  }
}
